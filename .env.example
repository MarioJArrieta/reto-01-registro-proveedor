# Clave del proveedor del modelo (obligatoria para el chat; demo.ts no la necesita)
ANTHROPIC_API_KEY=
# Modelo (opcional)
LLM_MODEL=claude-sonnet-5-5
# Clave para proteger el link público (opcional; si se define, el front la pide)
ACCESS_KEY=
# Topes de costo (opcionales)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_SESIONES=200
LLM_TIMEOUT_MS=90000
# Fecha de ejecución para vencimiento de soportes (opcional, YYYY-MM-DD; por defecto hoy en Bogotá)
FECHA_EJECUCION=
PORT=3000
